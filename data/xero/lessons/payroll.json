          "id": "step-1",
          "order": 1,
          "title": "Open leave request",
          "instruction": "Click Morgan Lee's leave request.",
          "highlightTarget": "leave-request-row",
          "action": {
            "type": "click",
            "target": "leave-request-row",
            "feedback": {
              "correct": "Leave request opened.",
              "incorrect": "Click Morgan Lee's leave request row."
            }
          },
          "simulatorState": "leave-management"
        },
        {
          "id": "step-2",
          "order": 2,
          "title": "Review calendar",
          "instruction": "Click the leave calendar preview.",
          "highlightTarget": "leave-calendar",
          "action": {
            "type": "click",
            "target": "leave-calendar",
            "feedback": {
              "correct": "Calendar reviewed.",
              "incorrect": "Click the leave calendar preview."
            }
          },
