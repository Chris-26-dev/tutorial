    {
      "id": "customizing-reports",
      "title": "Customizing Reports",
      "platform": "quickbooks",
      "module": "reports",
      "type": "interactive",
      "steps": [
        {
          "id": "step-1",
          "order": 1,
          "title": "Open customize",
          "instruction": "Click Customize on the report toolbar.",
          "highlightTarget": "report-customize",
          "action": {
            "type": "click",
            "target": "report-customize",
            "feedback": {
              "correct": "Customize panel opened.",
              "incorrect": "Click Customize above the report."
            }
          },
          "simulatorState": "report-customize"
        },
        {
          "id": "step-2",
          "order": 2,
          "title": "Change columns",
          "instruction": "Set Display columns by to Customers.",
          "highlightTarget": "report-columns",
          "action": {
            "type": "select",
            "target": "report-columns",
            "expectedValue": "customers",
            "feedback": {
              "correct": "Columns will group results by customer.",
              "incorrect": "Choose Customers from the Display columns by menu."
            }
          },
          "simulatorState": "report-customize"
        },
        {
          "id": "step-3",
          "order": 3,
          "title": "Apply changes",
          "instruction": "Click Run report to apply the customization.",
          "highlightTarget": "report-apply",
          "action": {
            "type": "click",
            "target": "report-apply",
            "feedback": {
              "correct": "Customized report applied.",
              "incorrect": "Click Run report in the customize panel."
            }
          },
          "simulatorState": "report-customize"
        }
      ],
      "quiz": {
        "question": "Why customize a report?",
        "options": ["To focus the report on the details you need", "To connect payroll taxes", "To create a receipt image", "To remove all customer balances"],
        "correctAnswer": "To focus the report on the details you need",
        "explanation": "Custom filters and columns make reports easier to analyze for a specific question."
      },
      "completionMessage": "You customized a QuickBooks report layout."
    }
  ]
}
