{
  "platform": "quickbooks",
  "module": "reports",
  "lessons": [
    {
      "id": "profit-loss-report",
      "title": "Profit & Loss Report",
      "platform": "quickbooks",
      "module": "reports",
      "type": "interactive",
      "steps": [
        {
          "id": "step-1",
          "order": 1,
          "title": "Open reports",
          "instruction": "Click Reports in the left navigation.",
          "highlightTarget": "reports-nav",
          "action": {
            "type": "click",
            "target": "reports-nav",
            "feedback": {
              "correct": "Reports list opened.",
              "incorrect": "Click Reports in the sidebar."
            }
          },
          "simulatorState": "reports-list"
        },
        {
          "id": "step-2",
          "order": 2,
          "title": "Choose Profit & Loss",
          "instruction": "Click Profit & Loss in the favorites list.",
          "highlightTarget": "reports-profit-loss",
          "action": {
            "type": "click",
            "target": "reports-profit-loss",
            "feedback": {
              "correct": "Profit & Loss report opened.",
              "incorrect": "Click Profit & Loss in the report list."
            }
          },
          "simulatorState": "reports-list"
        },
        {
          "id": "step-3",
          "order": 3,
          "title": "Run report",
          "instruction": "Click Run report.",
          "highlightTarget": "report-run",
          "action": {
            "type": "click",
            "target": "report-run",
            "feedback": {
              "correct": "Report refreshed.",
              "incorrect": "Click Run report above the report table."
            }
          },
          "simulatorState": "report-detail"
        }
      ],
      "quiz": {
        "question": "What does a Profit & Loss report summarize?",
        "options": ["Income and expenses", "Only bank passwords", "Employee addresses", "Invoice email templates"],
        "correctAnswer": "Income and expenses",
        "explanation": "Profit & Loss summarizes revenue, expenses, and net income for a period."
      },
      "completionMessage": "You opened and ran the Profit & Loss report."
    },
    {
      "id": "balance-sheet",
      "title": "Balance Sheet",
      "platform": "quickbooks",
      "module": "reports",
      "type": "interactive",
      "steps": [
        {
          "id": "step-1",
          "order": 1,
          "title": "Open balance sheet",
          "instruction": "Click Balance Sheet from the reports list.",
          "highlightTarget": "reports-balance-sheet",
          "action": {
            "type": "click",
            "target": "reports-balance-sheet",
            "feedback": {
              "correct": "Balance Sheet opened.",
              "incorrect": "Click Balance Sheet in the report list."
            }
          },
          "simulatorState": "reports-list"
        },
        {
          "id": "step-2",
          "order": 2,
          "title": "Choose period",
          "instruction": "Set the report period to This fiscal year.",
          "highlightTarget": "report-period",
          "action": {
            "type": "select",
            "target": "report-period",
            "expectedValue": "this-fiscal-year",
            "feedback": {
              "correct": "Report period selected.",
              "incorrect": "Choose This fiscal year from the period dropdown."
            }
          },
          "simulatorState": "report-detail"
        },
        {
          "id": "step-3",
          "order": 3,
          "title": "Run report",
          "instruction": "Click Run report to refresh the Balance Sheet.",
          "highlightTarget": "report-run",
          "action": {
            "type": "click",
            "target": "report-run",
            "feedback": {
              "correct": "Balance Sheet refreshed.",
              "incorrect": "Click Run report."
            }
          },
          "simulatorState": "report-detail"
        }
      ],
      "quiz": {
        "question": "Which categories appear on a Balance Sheet?",
        "options": ["Assets, liabilities, and equity", "Income, expenses, and payroll only", "Customers and vendors only", "Receipts and emails"],
        "correctAnswer": "Assets, liabilities, and equity",
        "explanation": "A Balance Sheet shows what the business owns, owes, and the owner's residual interest."
      },
      "completionMessage": "You selected a period and ran the Balance Sheet."
    },
    {
      "id": "cash-flow-statement",
