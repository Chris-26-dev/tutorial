      "platform": "quickbooks",
      "module": "reports",
      "type": "guided",
      "steps": [
        {
          "id": "step-1",
          "order": 1,
          "title": "Open cash flow",
          "instruction": "Click Statement of Cash Flows in the reports list.",
          "highlightTarget": "reports-cash-flow",
          "action": {
            "type": "click",
            "target": "reports-cash-flow",
            "feedback": {
              "correct": "Cash flow report opened.",
              "incorrect": "Click Statement of Cash Flows."
            }
          },
          "simulatorState": "reports-list"
        },
        {
          "id": "step-2",
          "order": 2,
          "title": "Review operating cash",
          "instruction": "Click the Operating activities section.",
          "highlightTarget": "cash-flow-operating",
          "action": {
            "type": "click",
            "target": "cash-flow-operating",
            "feedback": {
              "correct": "Operating cash details expanded.",
              "incorrect": "Click Operating activities in the report."
            }
          },
          "simulatorState": "report-detail"
        },
        {
          "id": "step-3",
          "order": 3,
          "title": "Export report",
          "instruction": "Click Export to prepare a spreadsheet copy.",
          "highlightTarget": "report-export",
          "action": {
            "type": "click",
