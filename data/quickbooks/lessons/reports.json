          },
          "simulatorState": "report-detail"
        }
      ],
      "quiz": {
        "question": "What does a Cash Flow Statement focus on?",
        "options": ["Cash inflows and outflows", "Only customer names", "Only payroll addresses", "The app color palette"],
        "correctAnswer": "Cash inflows and outflows",
        "explanation": "Cash flow reports explain how cash moved through operating, investing, and financing activities."
      },
      "completionMessage": "You reviewed core sections of a cash flow report."
